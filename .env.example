# Copy to .env. Nothing here is required for local use — every default source works
# without keys. The dashboard only locks itself when DASHBOARD_PASSWORD is set.

# ---- dashboard login (REQUIRED once it's on the public internet) ----
# Empty = no login. Fine on her laptop, not fine on Railway.
DASHBOARD_PASSWORD=
# Signs the session cookie. Generate with: openssl rand -hex 32
# If unset, a random secret is made per boot, so every restart logs her out.
SESSION_SECRET=
# Set to 1 in production (Railway is HTTPS) so the cookie is HTTPS-only.
COOKIE_SECURE=

# ---- storage ----
# Point these at a mounted volume in production so saved/applied state survives deploys.
DB_PATH=
PROFILE_PATH=

# ---- daily scrape ----
SCRAPE_HOUR_UTC=3      # 03:00 UTC = 08:30 IST
SCRAPE_ON_BOOT=1       # fill an empty DB on first deploy
RUN_SCHEDULER=1        # 0 disables the daily scrape

# ---- email digest (optional) ----
# Gmail: turn on 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=you@gmail.com
DIGEST_TO=her-email@example.com

# ---- Apify (optional, costs money) ----
# Powers LinkedIn creator-post scraping and the bot-walled job boards WITHOUT putting
# her own LinkedIn account at risk — the scrape runs on Apify's infrastructure.
# Comma-separated; the source picks whichever token has the most headroom left.
# Leave blank to fall back to the shared pool in cold-email-rig/.env, which is capped
# at $5/month per account and is ALSO used by the cold-email rig.
# Turn it on with sources.apify.enabled: true in config.yaml.
APIFY_TOKENS=

# ---- LinkedIn cookie (optional, free but uses HER account) ----
# Alternative to Apify for creator posts. Higher risk: automated access is against
# LinkedIn's ToS and heavy use can get an account restricted. Apify is the safer path.
# Chrome → DevTools → Application → Cookies → https://www.linkedin.com → li_at, JSESSIONID
LI_AT=
LI_JSESSIONID=
